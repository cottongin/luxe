[33.709382, "o", ";14m                                                                                                        \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[6;5H\u2502\u001b[39;48;2;18;16;14m \u001b[1m\u001b[38;2;228;223;214;48;2;18;16;14mAdd a `todo overdue` command\u001b[22m\u001b[39;48;2;18;16;14m                                                                                 \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[7;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                              \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[8;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;151;147;140;48;2;18;16;14mDescription\u001b[39;48;2;18;16;14m                                                                                                  \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[9;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mLet a user see which open tasks have slipped past their due date, with the most overdue ones first.\u001b[39;48;2;18;16;14m         \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[10;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[11;5H\u2502\u001b[39;48;2;18;16;14m \u001b[1m\u001b[38;2;221;192;132;48;2;18;16;14mThe overdue filter\u001b[22m\u001b[39;48;2;18;16;14m                                                                                          \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[12;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[13;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mAdds \u001b[38;2;250;170;81;48;2;18;16;14moverdue(tasks, today)\u001b[38;2;228;223;214;48;2;18;16;14m to the filters. It keeps open tasks with a due date before today and sorts them\u001b[39;48;2;18;16;14m  \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[14;7H\u001b[38;2;228;223;214;48;2;18;16;14moldest first. Like the other filters, it takes the date as text and compares it as text.\u001b[14;115H\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[15;115H\u2590\u001b[16;7H\u001b[38;2;228;223;214;48;2;18;16;14mNew exported function only. Existing filters are unchanged. It has no caller until the CLI chapter.\u001b[16;115H\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[17;6H\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[18;7H\u001b[1mThe todo overdue command\u001b[18;115H\u001b[22m\u2590\u001b[19;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[20;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mWires the filter into the CLI. The new \u001b[38;2;250;170;81;48;2;18;16;14moverdue\u001b[38;2;228;223;214;48;2;18;16;14m case computes today's date as an ISO day string and shows the\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[21;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mresult. The import and the usage text are updated to match.\u001b[39;48;2;18;16;14m                                                 \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[22;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[23;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mUsers get a new \u001b[38;2;250;170;81;48;2;18;16;14mtodo overdue\u001b[38;2;228;223;214;48;2;18;16;14m command. Nothing else in the CLI changes. Today's date is taken from the system\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[24;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mclock in UTC, so the day can differ from local time near midnight.\u001b[39;48;2;18;16;14m                                          \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[25;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[26;5H\u2502\u001b[39;48;2;18;16;14m \u001b[1m\u001b[38;2;221;192;132;48;2;18;16;14mTest"]
[33.711023, "o", " for overdue\u001b[22m\u001b[39;48;2;18;16;14m                                                                                            \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[27;5H\u2502\u001b[39;48;2;18;16;14m                                                                                                             \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[28;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mAdds one test that mixes the shared sample tasks with extra cases: one older, one due today, one with no due\u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[29;5H\u2502\u001b[38;2;46;43;39;48;2;18;16;14m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[30;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;221;192;132;48;2;18;16;14menter\u001b[38;2;228;223;214;48;2;18;16;14m open\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14mt\u001b[38;2;228;223;214;48;2;18;16;14m title\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14me\u001b[38;2;228;223;214;48;2;18;16;14m description\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14mE\u001b[38;2;228;223;214;48;2;18;16;14m in your editor\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14md\u001b[38;2;228;223;214;48;2;18;16;14m draft\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14m\u2191/\u2193\u001b[38;2;228;223;214;48;2;18;16;14m scroll\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14mesc\u001b[38;2;228;223;214;48;2;18;16;14m cancel\u001b[39;48;2;18;16;14m                  \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[31;5H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l\u001b[?2026l"]
