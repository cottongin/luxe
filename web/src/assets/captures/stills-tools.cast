[3.54939, "o", "tool <name>\u001b[38;2;151;147;140;48;2;18;16;14m or \u001b[38;2;250;170;81;48;2;18;16;14mluxe --no-tool <name>\u001b[38;2;151;147;140;48;2;18;16;14m to turn one on or off for a single session.\u001b[39;48;2;18;16;14m        \u001b[32;45H \u001b[32;47H                                                      \u001b[32;149H \u001b[33;45H \u001b[38;2;221;192;132;48;2;18;16;14mshift+tab\u001b[38;2;151;147;140;48;2;18;16;14m for plan mode  \u00b7  \u001b[38;2;221;192;132;48;2;18;16;14m/\u001b[38;2;151;147;140;48;2;18;16;14m or \u001b[38;2;221;192;132;48;2;18;16;14mctrl+k\u001b[38;2;151;147;140;48;2;18;16;14m for commands  \u00b7  \u001b[38;2;221;192;132;48;2;18;16;14m@\u001b[38;2;151;147;140;48;2;18;16;14m to reference files, skills, and more\u001b[39;48;2;18;16;14m         \u001b[35;46H      \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[35;46H\u001b[?2026l"]
