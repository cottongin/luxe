[30.157807, "o", "81;48;2;18;16;14mtodo due 2026-3-4\u001b[38;2;228;223;214;48;2;18;16;14m now behaves like \u001b[38;2;250;170;81;48;2;18;16;14mtodo due 2026-03-04\u001b[38;2;228;223;214;48;2;18;16;14m. A date that isn't year-month-day is rejected with a\u001b[39;48;2;18;16;14m        \u001b[12;3H\u001b[38;2;228;223;214;48;2;18;16;14mmessage. All 5 tests pass, and the two new ones failed before the change.\u001b[39;48;2;18;16;14m                                          \u001b[14;3H\u001b[38;2;228;223;214;48;2;18;16;14mThe actual bug was a bit different\u001b[14;38Hfrom the report. The\u001b[14;59Hshor\u001b[14;64H date wa\u001b[14;77Hmatching nothing.\u001b[14;95HIt was compared as\u001b[15;3Ht\u001b[15;5Hxt against\u001b[15;16Hthe padded dates,\u001b[15;34Hso i\u001b[15;39H also matched tasks due on later days. For example, \u001b[38;2;250;170;81;48;2;18;16;14m2026-3-10\u001b[38;2;228;223;214;48;2;18;16;14m pulled in tasks\u001b[16;3Hdue 2026-03-14 and 2026-03-20.\u001b[17;3H\u001b[39;48;2;18;16;14m                                                                                                              \u001b[18;3H\u001b[38;2;228;223;214;48;2;18;16;14m\u2022 \u001b[1mFix:\u001b[22m \u001b[38;2;250;170;81;48;2;18;16;14mdueBy\u001b[18;16H\u001b[38;2;228;223;214;48;2;18;16;14min \u001b[38;2;250;170;81;48;2;18;16;14msrc/filter.js\u001b[38;2;228;223;214;48;2;18;16;14m pads \u001b[18;39Hhe m\u001b[18;44Hnth and day with zeros before comparing. It does this on\u001b[18;101Hthe text,\u001b[18;111Hso\u001b[39;48;2;18;16;14m   \u001b[19;3H\u001b[38;2;228;223;214;48;2;18;16;14m  dates are still never parsed into \u001b[38;2;250;170;81;48;2;18;16;14mDate\u001b[38;2;228;223;214;48;2;18;16;14m.\u001b[20;3H\u2022 \u001b[1mError case:\u001b[22m anything that isn't year-month-day, like \u001b[38;2;250;170;81;48;2;18;16;14mMarch 4\u001b[38;2;228;223;214;48;2;18;16;14m, throws \"\u2026 is not a date; use YYYY-MM-DD\".\u001b[21;3H \u001b[21;5H\u001b[38;2;250;170;81;48;2;18;16;14msrc/cli.js\u001b[21;16H\u001b[38;2;228;223;214;48;2;18;16;14mprints that to stderr\u001b[21;38Hand\u001b[21;42Hexi\u001b[21;46Hs\u001b[21;48H1. I checked\u001b[21;61Hthe error case only through the\u001b[21;93Hun\u001b[21;96Ht\u001b[21;98Htes\u001b[21;102H, not by\u001b[39;48;2;18;16;14m   \u001b[22;5H\u001b[38;2;228;223;214;48;2;18;16;14mrunning the CLI.\u001b[39;48;2;18;16;14m                       \u001b[23;5H\u001b[1m\u001b[38;2;228;223;214;48;2;18;16;14mWhat the tests guard:\u001b[22m \u001b[38;2;250;170;81;48;2;18;16;14m2026-3-10\u001b[23;37H\u001b[38;2;228;223;214;48;2;18;16;14ms\u001b[23;39Hlects exactly\u001b[23;53Hthe same tasks as \u001b[38;2;250;170;81;48;2;18;16;14m2026-03-10\u001b[38;2;228;223;214;48;2;18;16;14m, and \u001b[23;88H non-date is an error\u001b[24;5Hinstead of\u001b[24;16Hsilently matching nothi\u001b[24;40Hg.\u001b[39;48;2;18;16;14m                                                                    \u001b[25;3H                  \u001b[26;3H\u001b[38;2;218;213;205;48;2;18;16;14mI\u001b[38;2;208;203;195;48;2;18;16;14m \u001b[38;2;198;193;185;48;2;18;16;14md\u001b[38;2;187;183;175;48;2;18;16;14mi\u001b[38;2;176;172;165;48;2;18;16;14md\u001b[38;2;165;161;154;48;2;18;16;14mn\u001b[38;2;153;149;143;48;2;18;16;14m'\u001b[38;2;141;137;131;48;2;18;16;14mt\u001b[38;2;129;125;119;48;2;18;16;14m \u001b[38;2;115;112;107;48;2;18;16;14mc\u001b[38;2;101;98;93;48;2;18;16;14mh\u001b[38;2;86;83;79;48;2;18;16;14me\u001b[38;2;69;67;63;48;2;18;16;14mc\u001b[38;2;50;47;44;48;2;18;16;14mk\u001b[38;2;18;16;14;48;2;18;16;14m \u001b[39;48;2;18;16;14m                                                                                  \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[30;3H\u001b[?2026l"]
