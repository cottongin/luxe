[23.738391, "o", "\u001b[1;3H\u001b[38;2;228;223;214;48;2;18;16;14mI added \u001b[38;2;250;170;81;48;2;18;16;14mtodo overdue\u001b[38;2;228;223;214;48;2;18;16;14m. It lists open tasks whose due date is\u001b[39;48;2;18;16;14m        \u001b[2;3H\u001b[38;2;228;223;214;48;2;18;16;14mbefore today, oldest due date first. Tasks with no due date and\u001b[3;3Htasks that are done are left out, and a task due today doe\u001b[3;62Hn't\u001b[4;3Hcount as overdue.\u001b[39;48;2;18;16;14m                                              \u001b[5;3H                                                              \u001b[6;3H\u001b[38;2;228;223;214;48;2;18;16;14mThe new \u001b[38;2;250;170;81;48;2;18;16;14moverdue(tasks, today)\u001b[38;2;228;223;214;48;2;18;16;14m filter is in \u001b[38;2;250;170;81;48;2;18;16;14msrc/filter.js\u001b[38;2;228;223;214;48;2;18;16;14m, and the\u001b[7;3Hcommand is wired up in \u001b[38;2;250;170;81;48;2;18;16;14msrc/cli.js\u001b[38;2;228;223;214;48;2;18;16;14m and listed in the usage text.\u001b[8;3H\u001b[38;2;250;170;81;48;2;18;16;14mtoday\u001b[38;2;228;223;214;48;2;18;16;14m is the local date as a text str\u001b[8;41Hng like \u001b[38;2;250;"]
[23.738465, "o", "170;81;48;2;18;16;14m2026-03-14\u001b[8;61H\u001b[38;2;228;223;214;48;2;18;16;14mso no\u001b[39;48;2;18;16;14m  \u001b[9;3H\u001b[38;2;250;170;81;48;2;18;16;14mDate\u001b[38;2;228;223;214;48;2;18;16;14m parsing is involved.\u001b[39;48;2;18;16;14m                                      \u001b[10;3H                                                               \u001b[11;3H\u001b[38;2;228;223;214;48;2;18;16;14mThe new test\u001b[11;17Hn\u001b[11;19H\u001b[38;2;250;170;81;48;2;18;16;14mtest/filter.test.js\u001b[38;2;228;223;214;48;2;18;16;14m covers the done task, the\u001b[12;3Hundated task and the ordering. \u001b[38;2;250;170;81;48;2;18;16;14mnpm test\u001b[38;2;228;223;214;48;2;18;16;14m passes (4 tests). I\u001b[13;3Hdidn't run \u001b[38;2;250;170;81;48;2;18;16;14mnode src/cl\u001b[13;26H.js ov\u001b[13;33Hrdue\u001b[38;2;228;223;214;48;2;18;16;14m by hand, and I didn't check\u001b[14;3Hthat the test fails without the filter.\u001b[39;48;2;18;16;14m                    \u001b[15;3H                                                              \u001b[16;3H\u001b[38;2;151;147;140;48;2;18;16;14m\uf120 [review] Review of working tree is ready \u00b7 3 chapters\u001b[20;3H\u001b[38;2;129;202;160;48;2;18;16;14m\udb80\ude3b \u001b[20;12H\u001b[38;2;151;147;140;48;2;18;16;14mready \u00b7 \u001b[38;2;129;202;160;48;2;18;16;14mctrl+g\u001b[39;48;2;18;16;14m                                \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[22;3H\u001b[?2026l"]
[24.938465, "o", "\u001b[?2026h"]
