[32.520882, "o", "\u001b[2;5H\u001b[38;2;221;192;132;48;2;18;16;14m\u256d \udb80\udea4 \u001b[1m\u001b[38;2;228;223;214;48;2;18;16;14mOpen pull request\u001b[22m\u001b[38;2;221;192;132;48;2;18;16;14m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[3;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;221;192;132;48;2;18;16;14mInto \u001b[38;2;250;170;81;48;2;18;16;14mmain\u001b[38;2;221;192;132;48;2;18;16;14m from \u001b[38;2;250;170;81;48;2;18;16;14mtodo-overdue\u001b[38;2;221;192;132;48;2;18;16;14m \u00b7 commits and pushes first\u001b[39;48;2;18;16;14m       \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[4;5H\u2502\u001b[39;48;2;18;16;14m                                                              \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[5;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;151;147;140;48;2;18;16;14mTitle\u001b[39;48;2;18;16;14m                                                        \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[6;5H\u2502\u001b[39;48;2;18;16;14m \u001b[1m\u001b[38;2;228;223;214;48;2;18;16;14mAdd a `todo overdue` command\u001b[22m\u001b[39;48;2;18;16;14m                          "]
[32.521217, "o", "       \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[7;5H\u2502\u001b[39;48;2;18;16;14m                                                              \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[8;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;151;147;140;48;2;18;16;14mDescription\u001b[39;48;2;18;16;14m                                                  \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[9;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mUsers had no way to see which open tasks have slipped past\u001b[39;48;2;18;16;14m  \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u2502\u001b[10;7H\u001b[38;2;228;223;214;48;2;18;16;14mtheir due date. This adds a \u001b[38;2;250;170;81;48;2;18;16;14mtodo overdue\u001b[38;2;228;223;214;48;2;18;16;14m command that lists\u001b[10;67H\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[11;7H\u001b[38;2;228;223;214;48;2;18;16;14mthem, oldest due date first.\u001b[11;67H\u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[12;67H\u2590\u001b[13;6H\u001b[39;48;2;18;16;14m \u001b[1m\u001b[38;2;221;192;132;48;2;18;16;14mAdd the overdue filter\u001b[22m\u001b[39;48;2;18;16;14m                                      \u001b[38;2;221;192;132;48;2;18;16;14m\u2590\u001b[14;7H\u001b[39;48;2;18;16;14m          \u001b[14;67H\u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[15;5H\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mA new pure function \u001b[38;2;250;170;81;48;2;18;16;14moverdue(tasks, today)\u001b[38;2;228;223;214;48;2;18;16;14m returns open tasks\u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[16;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mdue before today, oldest first. It compares day strings as\u001b[39;48;2;18;16;14m  \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[17;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mtext, as the repo rules require.\u001b[39;48;2;18;16;14m                            \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[18;5H\u2502\u001b[39;48;2;18;16;14m                                                             \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[19;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mAdds a new export in src/filter.js. Nothing existing\u001b[39;48;2;18;16;14m        \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[20;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;228;223;214;48;2;18;16;14mchanges. A task due today is left out.\u001b[39;48;2;18;16;14m                      \u001b[38;2;46;43;39;48;2;18;16;14m\u2595\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[21;5H\u2502\u001b[38;2;46;43;39;48;2;18;16;14m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[22;5H\u2502\u001b[39;48;2;18;16;14m \u001b[38;2;221;192;132;48;2;18;16;14menter\u001b[38;2;228;223;214;48;2;18;16;14m open\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14mt\u001b[38;2;228;223;214;48;2;18;16;14m title\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14me\u001b[38;2;228;223;214;48;2;18;16;14m description\u001b[38;2;151;147;140;48;2;18;16;14m \u00b7 \u001b[38;2;221;192;132;48;2;18;16;14mesc\u001b[38;2;228;223;214;48;2;18;16;14m cancel\u001b[39;48;2;18;16;14m            \u001b[38;2;221;192;132;48;2;18;16;14m\u2502\u001b[23;5H\u2570\u2500\u2500\u2500\u2500\