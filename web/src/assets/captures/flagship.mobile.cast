[32.484108, "o", "\u001b[6;5H\u001b[38;2;151;147;140;48;2;46;43;39m @@ -1,12 +1,13 @@ \u001b[38;2;77;74;69;48;2;18;16;14m                                             \u001b[7;5H1  1  \u001b[3m#!/usr/bin/env node\u001b[23m                                       \u001b[8;5H2  2  \u001b[3m/** todo \u2014 a task list small enough to read in one sitting\u001b[9;5H\u001b[23m\u001b[38;2;221;192;132;48;2;18;16;14m\u256d \udb80\udea4 \u001b[1m\u001b[38;2;228;223;214;48;2;18;16;14mOpen pull request\u001b[22m\u001b[38;2;221;192;132;48;2;18;16;14m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[10;6H\u001b[39;48;2;18;16;14m \u001b[38;2;151;147;140;48;2;18;16;14m\u2819 Drafting it from the revi\u001b[10;35Hw\u2026\u001b[39;48;2;18;16;14m                               \u001b[11;6H                                                              \u001b[12;6H                                                              \u001b[13;6H\u001b[38;2;46;43;39;48;2;18;16;14m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[32.48461, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[14;6H\u001b[39;48;2;18;16;14m \u001b[38;2;221;192;132;48;2;18;16;14mesc\u001b[14;11H\u001b[38;2;228;223;214;48;2;18;16;14mcancel\u001b[39;48;2;18;16;14m                                                   \u001b[15;5H\u001b[38;2;221;192;132;48;2;18;16;14m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[16;5H\u001b[38;2;77;74;69;48;2;18;16;14m9  9  todo due <DATE>                                           \u001b[17;5H\u001b[38;2;77;74;69;48;2;26;49;36m  10 +todo overdue                                              \u001b[18;5H\u001b[38;2;77;74;69;48;2;18;16;14m0 11  todo done <title>`;                                       \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l\u001b[?2026l"]
