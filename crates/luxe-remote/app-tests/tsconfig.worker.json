{
  // Type-checks the service worker, which runs with the worker globals rather than a page's.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "webworker"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["../app/worker/*.js"]
}
