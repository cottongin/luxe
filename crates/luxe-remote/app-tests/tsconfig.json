{
  // Type-checks the phone app from its JSDoc; nothing is emitted, since the app ships as written.
  // The vendored libraries resolve to the same versions installed here, whose declarations stand in
  // for the minified files the browser runs. The tests have their own, looser, tsconfig.tests.json.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "preact": ["./node_modules/preact"],
      "preact/hooks": ["./node_modules/preact/hooks"],
      "htm": ["./node_modules/htm"],
      "@preact/signals": ["./node_modules/@preact/signals"]
    }
  },
  "include": ["../app/*.js"]
}
